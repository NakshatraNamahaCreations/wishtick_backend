# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated allowlist. Use * only in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public base URL of this API (used to build verification/reset links)
APP_URL=http://localhost:3000
# Public base URL of the web client (used in emails)
WEB_APP_URL=http://localhost:5173
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017
# Atlas:      mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=wishtick_dev
# Connection-pool bounds. Raise max under load test; min keeps warm sockets ready.
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=wishtick:

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_REFRESH_TTL=30d
JWT_ISSUER=wishtick
JWT_AUDIENCE=wishtick-app

# ─── OTP / verification ───────────────────────────────────────────────────────
OTP_LENGTH=4
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=1800

# ─── Rate limiting (defaults; per-route overrides live in code) ───────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── Delivery drivers ─────────────────────────────────────────────────────────
# mailer: console (dev, logs only) | ses (AWS SES v2)
MAILER_DRIVER=console
# sms: console (dev, logs only) | http (generic MSG91/Twilio-style HTTP gateway)
SMS_DRIVER=console
MAIL_FROM="Wishtick <no-reply@wishtick.app>"
# Required when MAILER_DRIVER=ses. SES_REGION falls back to S3_REGION if blank.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional SES configuration set (enables bounce/complaint event publishing).
SES_CONFIGURATION_SET=
# Required when SMS_DRIVER=http. The gateway receives POST {to, body, from}.
SMS_HTTP_ENDPOINT=
SMS_HTTP_AUTH_TOKEN=
SMS_SENDER_ID=WISHTK

# push: console (dev, logs the payload) | fcm (Firebase Cloud Messaging HTTP v1)
# Nothing reaches a handset on 'console' — the token registry, dedupe and retry
# all run, the send is just printed. Switch to 'fcm' once the three values below
# are filled in; boot fails if any is missing while this says fcm.
PUSH_DRIVER=console

# From the Firebase console: Project settings → Service accounts → Generate new
# private key. That downloads a JSON file; these three fields are in it, named
# project_id, client_email and private_key.
#
# This is a credential that can send a notification to every install of the app.
# Keep it out of git — .env is ignored, this example file is not.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The private_key value with its real newlines replaced by the two characters
# \n, wrapped in double quotes — an env var cannot hold a line break, and the
# adapter converts them back before signing. Copy it whole, including the
# -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY----- lines.
# Example shape (not a real key):
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ─── Notifications ────────────────────────────────────────────────────────────
# Local-time [start, end) window during which non-critical email/SMS is deferred.
NOTIF_QUIET_HOURS_START=22
NOTIF_QUIET_HOURS_END=8
# Hour (local) the once-daily digest of low-signal notifications is sent.
NOTIF_DIGEST_HOUR=9
# Signs unsubscribe links. Defaults to JWT_ACCESS_SECRET if blank.
NOTIF_UNSUBSCRIBE_SECRET=
# Hours after a gift is fulfilled before the thank-you note auto-sends.
THANK_YOU_DELAY_HOURS=24
# Signs the SES bounce/complaint webhook. Empty = webhook rejected (fail closed).
NOTIF_BOUNCE_WEBHOOK_SECRET=
# In-app notifications older than this are dropped by a TTL index.
NOTIF_RETENTION_DAYS=180
# How many dispatch jobs the notifications worker runs at once (I/O-bound).
NOTIF_WORKER_CONCURRENCY=4

# ─── Reels (video compilation) ────────────────────────────────────────────────
# Server-enforced caps, re-verified by ffprobe at submit time.
REEL_MAX_AUDIO_SECONDS=60
REEL_MAX_VIDEO_SECONDS=90
# Hard timeout on each ffmpeg/ffprobe child process (ms).
REEL_FFMPEG_TIMEOUT_MS=120000
# Concurrent reel compiles per worker. ffmpeg is CPU-heavy — keep small.
REEL_WORKER_CONCURRENCY=1
# When off, every wish is auto-approved (moderation queue is Sprint 11).
REEL_MODERATION_ENABLED=false
# Scratch space for renders. Cleaned on every exit path. Put on a fast disk.
REEL_TEMP_DIR=./.reels-tmp
REEL_WATERMARK=Wishtick

# ─── Admin panel ──────────────────────────────────────────────────────────────
# A DISTINCT JWT audience so a user token can never validate on /admin.
ADMIN_JWT_AUDIENCE=wishtick-admin
# Distinct admin signing secret (best practice). Falls back to JWT_ACCESS_SECRET
# in dev; the distinct audience is what actually separates the token spaces.
ADMIN_JWT_ACCESS_SECRET=
# Short admin sessions.
ADMIN_ACCESS_TTL_HOURS=2
# Seeds the first super-admin on boot if no admin exists. First login is
# password-only; TOTP enrollment is then mandatory before anything else.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ─── Analytics ────────────────────────────────────────────────────────────────
# Raw AnalyticsEvent retention (TTL index), in days.
ANALYTICS_RAW_TTL_DAYS=180
# Analytics dashboard Redis cache, in seconds.
ANALYTICS_CACHE_TTL_SECONDS=300
# How many rollup jobs the analytics worker runs at once.
ANALYTICS_WORKER_CONCURRENCY=2

# ─── Storage / media ──────────────────────────────────────────────────────────
# local = signed uploads to disk via this API (dev only). s3 = presigned S3 PUTs.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
MEDIA_URL_TTL_SECONDS=900
MEDIA_MAX_BYTES=10485760
# Only used by the local driver; defaults to JWT_ACCESS_SECRET if blank.
STORAGE_SIGNING_SECRET=

# Required when STORAGE_DRIVER=s3 (boot fails without bucket + region).
#
# Bunny Edge Storage speaks S3 (public preview) and supports presigned URLs, so
# it drives this same adapter — no Bunny-specific storage code. The zone must be
# created with "S3 Compatibility" toggled ON; the switch is offered only at
# creation time, and a zone made without it cannot be converted.
#
# Bunny → Storage → your zone → Access → the **S3 tab** (not API/HTTP, not FTP):
#   S3_BUCKET            the storage zone name
#   S3_ACCESS_KEY_ID     the storage zone name AGAIN — Bunny uses the zone name
#                        as the access key id, so these two are the same string.
#                        That is not a copy/paste slip.
#   S3_SECRET_ACCESS_KEY the zone's "Password" (the read-write one; the
#                        read-only password cannot upload)
#   S3_ENDPOINT          https://<region>-s3.storage.bunnycdn.com — note the
#                        `-s3`. The API/HTTP tab shows a *different* host
#                        (<region>.storage.bunnycdn.com) for Bunny's own REST
#                        API, and that one does not speak S3.
#   S3_REGION            the bare region code: de, ny, sg, uk, se, la or jh
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for S3-compatible services (Bunny, Cloudflare R2, MinIO, Spaces).
S3_ENDPOINT=
# Non-AWS endpoints almost never serve virtual-host-style buckets. True for Bunny.
S3_FORCE_PATH_STYLE=true
# CDN base for public reads; falls back to the S3 object URL. For Bunny this is
# the PULL zone hostname, not the storage zone — a storage zone has no public
# URL of its own, which is the step everyone misses.
#   https://<pull-zone-name>.b-cdn.net
S3_PUBLIC_BASE_URL=

# The AWS SDK has computed a CRC32 checksum on every PutObject since ~3.729 and
# folds `x-amz-checksum-*` into the signature. A phone PUTting to a presigned URL
# never sends those headers, so the signature will not match on any provider that
# does not implement them. Set false to make checksums opt-in instead.
# AWS itself is unaffected either way.
S3_REQUEST_CHECKSUMS=false

# ─── Bunny Stream (video) ─────────────────────────────────────────────────────
# Video does not go in the storage zone. A 50 MB phone .mov served as a flat file
# stutters on Indian mobile, so Stream transcodes to HLS and hands back a
# playlist; MEMORY_WISH and THANK_YOU both accept video/mp4 and video/quicktime.
#
# 'storage' keeps video in whatever STORAGE_DRIVER points at — correct for local
# dev, where there is no reason to reach a vendor. 'bunny_stream' routes it to
# the library below; boot fails if the four values are not set.
VIDEO_DRIVER=storage

# Bunny → Stream → your library. The ID is in the dashboard URL:
# dash.bunny.net/stream/<library-id>/…
BUNNY_STREAM_LIBRARY_ID=743249
# Stream → API. Creates videos and signs the client's direct (TUS) upload, so the
# bytes still never pass through this API.
BUNNY_STREAM_API_KEY=
# Stream → Security → General → "Token authentication key". Signs playback URLs.
# Separate from the API key above: this one only proves a URL was minted by us,
# and is the weaker of the two if it leaks.
BUNNY_STREAM_TOKEN_KEY=
# Stream → Delivery. The playback host, e.g. vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=vz-0b6ddd18-ef0.b-cdn.net
# How long a signed playback URL stays valid. Must outlast the video itself —
# HLS re-requests segments the whole way through, so a token that expires
# mid-playback kills the video partway rather than refusing it up front.
# 4 hours covers the 90s reel cap with room for a paused, resumed watch.
BUNNY_STREAM_TOKEN_TTL_SECONDS=14400

# ─── Account lifecycle ────────────────────────────────────────────────────────
# Soft-deleted accounts are restorable for this long, then anonymized.
ACCOUNT_DELETION_GRACE_DAYS=30

# ─── Gifting ──────────────────────────────────────────────────────────────────
# A reservation auto-releases after this long if not purchased.
RESERVATION_TTL_HOURS=72
RESERVATION_WARN_HOURS=12
# Per-provider affiliate webhook signing secrets, as JSON {"provider":"secret"}.
# Empty = no provider configured = every webhook rejected (fail closed).
GIFT_WEBHOOK_SECRETS=
# A webhook whose signed timestamp is older than this is rejected (replay guard).
GIFT_WEBHOOK_TOLERANCE_SECONDS=300

# ─── Group gifting ────────────────────────────────────────────────────────────
# Smallest allowed contribution, in minor units (100 = ₹1). Blocks dust pledges.
GROUP_GIFT_MIN_CONTRIBUTION_MINOR=100
# Sanity ceiling on a group-gift target, in minor units (100000000 = ₹1,000,000).
GROUP_GIFT_MAX_TARGET_MINOR=100000000

# ─── Products / affiliate ─────────────────────────────────────────────────────
# 'fixture' is an in-memory sample catalogue for dev and tests. Boot fails if it
# is left on in production — it would show users products that do not exist.
# 'serpapi' reads Google Shopping and needs SERPAPI_KEY; boot fails without it.
PRODUCT_PROVIDER=fixture

# SerpApi (https://serpapi.com/manage-api-key). Two engines are used, and the
# cost split matters: `google_shopping` answers a search in one call, while
# `google_immersive_product` — the only source of a *merchant* URL, which is
# what an affiliate network can monetize — is charged as a separate search and
# is keyed by a token only a search response carries. So merchant links are
# resolved lazily, once per product, not once per search result.
# (`google_product` was the documented route; Google retired it — it now answers
# 400 "The Google Product service is no longer offered by Google".)
SERPAPI_KEY=
# Locale. The defaults target India; everything downstream assumes INR.
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en
SERPAPI_GOOGLE_DOMAIN=google.co.in

# The network that turns a merchant URL into a paid link.
# 'none' is a supported state: every outbound click still works, it just earns
# nothing. 'cuelinks' needs CUELINKS_API_KEY; boot fails without it.
AFFILIATE_NETWORK=none
# Publisher API key, sent as `Authorization: Token <key>`.
CUELINKS_API_KEY=
CUELINKS_BASE_URL=https://developers.cuelinks.com/pub_api/v3

# Guarding a third party we do not control. Each knob covers a different failure:
# the limiter protects the vendor's per-account quota, the timeout stops one slow
# call hogging a request, retries ride out a blip, the breaker stops us retrying
# into a full outage.
#
# 15s, not the 4s this started at: SerpApi proxies a live Google Shopping search,
# and measured latency straddles 4 seconds. At 4s a cold search failed all three
# attempts ("serpapi unavailable (timeout) and no cached results") while the very
# next identical call succeeded — so the timeout, not the vendor, was the outage.
# Retries drop to 1 for the same reason: a timeout here means Google is slow, and
# a second full wait doubles the user's latency without improving the odds.
PRODUCT_TIMEOUT_MS=15000
PRODUCT_MAX_RETRIES=1
PRODUCT_RETRY_BASE_DELAY_MS=150
PRODUCT_RATE_LIMIT_PER_MINUTE=600
PRODUCT_BREAKER_FAILURE_THRESHOLD=5
PRODUCT_BREAKER_RESET_MS=30000

# Search results count as fresh for CACHE_TTL, and may still be served for
# STALE_TTL while the provider is down. An old price beats a broken page.
PRODUCT_CACHE_TTL_SECONDS=21600
PRODUCT_PREWARM_ENABLED=true
PRODUCT_PREWARM_CRON=20 */4 * * *
PRODUCT_STALE_TTL_SECONDS=86400

# URL resolution. This endpoint makes the server fetch a link the user chose,
# so it is SSRF-sensitive — see src/common/net/ssrf-guard.ts.
PRODUCT_URL_FETCH_TIMEOUT_MS=5000
PRODUCT_URL_MAX_BYTES=524288
PRODUCT_URL_MAX_REDIRECTS=3
# DANGEROUS. Disables the SSRF address checks so tests can fetch a loopback
# server. Boot fails if this is true in production.
PRODUCT_URL_ALLOW_PRIVATE=false

# ─── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=
