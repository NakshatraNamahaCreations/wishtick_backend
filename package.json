{
  "name": "wishtick-backend",
  "version": "0.1.0",
  "description": "Wishtick MVP backend — NestJS, MongoDB Atlas, Redis, BullMQ",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:up": "node scripts/dev-mongo.js",
    "prestart": "node scripts/dev-mongo.js",
    "prestart:dev": "node scripts/dev-mongo.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "verify:storage": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/verify-storage.ts",
    "verify:video": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/verify-video.ts",
    "verify:fcm": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/verify-fcm.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migrate:up": "ts-node -r tsconfig-paths/register src/infra/migrations/cli.ts up",
    "migrate:status": "ts-node -r tsconfig-paths/register src/infra/migrations/cli.ts status",
    "prepare": "husky",
    "seed:admin": "ts-node -r tsconfig-paths/register -r dotenv/config src/infra/seed/seed-admin.ts",
    "seed:moderation": "ts-node -r tsconfig-paths/register -r dotenv/config src/infra/seed/seed-moderation.ts",
    "seed:analytics": "ts-node -T -r tsconfig-paths/register -r dotenv/config src/infra/seed/seed-analytics.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/client-sesv2": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.28",
    "@node-rs/argon2": "^2.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^5.4.0",
    "mongoose": "^8.13.1",
    "nanoid": "^3.3.8",
    "nestjs-pino": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/ioredis-mock": "^8.2.7",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
